#!/usr/bin/env python3
"""
ratchet-digest — 从 transcript 自动生成 session 日志的「机械部分」。

这是 K2 的实现。原工程要求模型在每次会话结束时手写 8 段日志（改了什么、
跑了什么命令、工时、成本、上下文……），230 个会话写了 1.86 MB。其中绝大多数
内容是机械事实 —— 模型是在用推理算力誊写 transcript 里已经有的东西。

机械事实交给机器：工具调用、改动文件、执行的命令、token 消耗，全部自动抽取。
模型只写机器写不出来的那一段 —— 决策与教训 —— 硬上限 1 KB。

用法:
  ratchet-digest --transcript <path> [--session N]
  echo '<hook payload>' | ratchet-digest        # 从 hook stdin 读

输出: markdown，写入 track/<日期>/session-N.md 的前半部分。
"""
import argparse
import datetime
import json
import os
import re
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "lib"))
import transcript  # noqa: E402

# 噪声：查看类命令，日志不需要（日志要的是「做了什么」，不是终端回放）
_NOISE = re.compile(r"^(ls|cat|head|tail|pwd|echo|wc|find|grep|which|printf|chmod|cd)\b|^git (status|log|diff|show)\b")
# 脚手架：变量赋值、set 选项、控制流、heredoc 内容 —— 都不是「命令」
_SCAFFOLD = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*=|^set\s+[-+]|^(if|then|else|fi|for|do|done|while|EOF|PY|\}|\{)\b|^#")
MAX_CMDS = 8
MAX_FILES = 12


def signal_commands(cmds: list[str]) -> list[str]:
    """抽出有信号的命令。

    首版的 bug：直接取多行脚本的第一行，结果抽出来全是 `TDIR=...` `set -u` 这类
    变量赋值。真正的命令往往在脚本中间。改为逐行扫描、剔除脚手架行，取第一条实质命令。
    """
    out = []
    for block in cmds:
        picked = None
        for ln in block.splitlines():
            ln = ln.strip()
            if not ln or _SCAFFOLD.match(ln) or _NOISE.match(ln):
                continue
            picked = ln
            break
        if not picked:
            continue
        if len(picked) > 100:
            picked = picked[:97] + "..."
        if picked not in out:
            out.append(picked)
    return out[:MAX_CMDS]


def rel(p: str, root: str) -> str:
    try:
        return os.path.relpath(p, root)
    except ValueError:
        return p


def render(d: transcript.Digest, session: int | None, root: str) -> str:
    today = datetime.date.today().isoformat()
    sid = f"s-{session}" if session is not None else "s-?"
    L = [f"# {sid} · {today}", ""]

    L.append("## 做了什么（自动抽取，勿手改）")
    L.append("")
    if d.files_written:
        L.append("**改动文件**")
        for f in d.files_written[:MAX_FILES]:
            L.append(f"- `{rel(f, root)}`")
        if len(d.files_written) > MAX_FILES:
            L.append(f"- …另有 {len(d.files_written) - MAX_FILES} 个")
        L.append("")

    cmds = signal_commands(d.commands)
    if cmds:
        L.append("**关键命令**")
        L.append("")
        L.append("```bash")
        L.extend(cmds)
        L.append("```")
        L.append("")

    tools = " · ".join(f"{k}×{v}" for k, v in d.tools.most_common(8))
    L.append(f"**工具**：{tools or '（无）'}")
    L.append(f"**轮次**：{d.turns}")
    L.append(
        f"**token**：in {d.input_tokens:,} · out {d.output_tokens:,} · "
        f"cache 读 {d.cache_read:,} / 写 {d.cache_write:,} · 合计 {d.total_tokens:,}"
    )
    if d.context_window:
        L.append(f"**上下文**：{d.context_pct}% ({d.context_used:,}/{d.context_window:,})")
    L.append("")
    L.append("---")
    L.append("")
    L.append("## 决策与教训（本节由你手写，≤ 1 KB）")
    L.append("")
    L.append("> 只写机器写不出来的东西：为什么这么选、哪里判断错了、下次别再踩什么。")
    L.append("> 不要复述上面已有的机械事实。写不满不用凑。")
    L.append("")
    L.append("- ")
    L.append("")
    return "\n".join(L)


def session_id(payload: dict) -> str:
    """本次会话的唯一标识。

    两条腿走路，任一可用即可 —— 不赌单一字段：
      1. payload.session_id：官方文档列为通用字段，但 SessionEnd 的完整 schema
         文档没给全，属未实测来源。
      2. transcript 文件名：实测过 —— basename 与 transcript 内的 sessionId 完全一致。
         digest 本来就吃 transcript_path，这个来源不额外依赖任何东西。
    """
    sid = str(payload.get("session_id") or "").strip()
    if sid:
        return sid
    tp = payload.get("transcript_path") or ""
    return os.path.splitext(os.path.basename(tp))[0] if tp else ""


def run_hook(payload: dict) -> int:
    """SessionEnd：把机械事实落盘，并标记『决策段待补』。

    不覆盖已存在的日志 —— 会话可能被 resume，重复触发不该抹掉已写的内容。
    非 ratchet 项目静默退出（plugin 装在全局，会在每个项目启动）。
    """
    root = payload.get("cwd") or os.environ.get("CLAUDE_PROJECT_DIR") or os.getcwd()
    rd = os.path.join(root, ".ratchet")
    state_p = os.path.join(rd, "state.json")
    if not os.path.isfile(state_p):
        print("{}")
        return 0

    try:
        st = json.load(open(state_p, encoding="utf-8"))
    except Exception:
        print("{}")
        return 0

    d = transcript.parse(payload.get("transcript_path", ""),
                         transcript.load_config(root).get("context_window"))
    if not d.turns:
        print("{}")
        return 0  # 空会话不留痕

    sess = st.setdefault("session", {})
    sid = session_id(payload)
    resumed = bool(sid) and sid == sess.get("id")

    logdir = os.path.join(rd, "log")
    os.makedirs(logdir, exist_ok=True)
    today = datetime.date.today().isoformat()

    # 首版的 bug：n 无脑取 last+1，然后 `if not exists(fp)` 静默跳过写入，
    # 却照样把 last 递增、照样报告「已生成日志草稿」。两个后果：
    #   · 谎报 —— 什么都没写，却说写了（违反纪律三：诚实）
    #   · 同一个会话被 resume，就白吃一个编号，日志序列里留下空洞
    # 根因是这个计数器不知道「会话」是什么，只会做加法。所以给它一个身份。
    if resumed:
        # 同一会话再次收尾（resume / clear）：不吃新编号。
        n = int(sess.get("last") or 0)
        fp = os.path.join(logdir, f"{today}-s{n}.md")
        wrote = not os.path.exists(fp)
        if wrote:  # 上次没写成（比如那次是空会话），补上
            open(fp, "w", encoding="utf-8").write(render(d, n, root))
    else:
        # 新会话：编号本不该撞。撞了说明 state 与 log 不同步（state 被手工改过？）——
        # 顺延到下一个空位，绝不覆盖别人的日志，也绝不静默跳过。
        n = int(sess.get("last") or 0) + 1
        fp = os.path.join(logdir, f"{today}-s{n}.md")
        while os.path.exists(fp):
            n += 1
            fp = os.path.join(logdir, f"{today}-s{n}.md")
        open(fp, "w", encoding="utf-8").write(render(d, n, root))
        wrote = True

    sess["last"] = n
    if sid:
        sess["id"] = sid
    sess["last_date"] = today
    if not resumed:
        sess["log_written"] = False  # 决策段还没写 —— 下次起手简报会顶着 ⚠️ 提醒
    st["updated_at"] = datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")
    with open(state_p, "w", encoding="utf-8") as fh:
        json.dump(st, fh, ensure_ascii=False, indent=2)

    # SessionEnd 没有 decision control，也不接受 hookSpecificOutput / additionalContext ——
    # 它是纯副作用事件，只认 universal 字段（systemMessage / suppressOutput / …）。
    # 见 https://code.claude.com/docs/en/hooks
    #
    # 首版吐了 hookSpecificOutput.additionalContext，平台校验直接失败：
    #   SessionEnd hook failed: Hook JSON output validation failed — (root): Invalid input
    # 日志其实落盘了（副作用在这行之前就发生了），但每次收尾都往用户终端喷一行红字。
    # 这是本项目第二次栽在「凭印象写 hook 输出协议」上（第一次是 PostToolUse 误用
    # permissionDecision）—— 所以现在每个 hook 事件的输出格式都有测试钉死。
    #
    # 只报告真实发生的事。文件没写就不许说「已生成」—— 那是把留痕的假象卖给用户，
    # 而留痕是 brief 和 slim 共同的地基。
    rp = os.path.relpath(fp, root)
    msg = (f"[ratchet] 已生成 s-{n} 日志草稿：{rp}（决策段待补）" if wrote
           else f"[ratchet] s-{n} 日志草稿已存在，未覆盖：{rp}")
    json.dump({"systemMessage": msg}, sys.stdout, ensure_ascii=False)
    print()
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("--transcript")
    ap.add_argument("--session", type=int)
    ap.add_argument("--hook", action="store_true")
    ap.add_argument("--root", default=os.environ.get("CLAUDE_PROJECT_DIR") or os.getcwd())
    a = ap.parse_args()

    if a.hook:
        try:
            payload = json.load(sys.stdin)
        except Exception:
            print("{}")
            return 0
        try:
            return run_hook(payload)
        except Exception:
            print("{}")  # 留痕失败绝不能把会话搞崩
            return 0

    path = a.transcript
    if not path and not sys.stdin.isatty():
        try:
            path = json.load(sys.stdin).get("transcript_path", "")
        except Exception:
            path = ""
    if not path:
        print("ratchet-digest: 需要 --transcript 或 hook stdin payload", file=sys.stderr)
        return 1

    d = transcript.parse(path)
    sys.stdout.write(render(d, a.session, a.root))
    return 0


if __name__ == "__main__":
    sys.exit(main())
