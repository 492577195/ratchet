#!/usr/bin/env python3
"""
ratchet-digest — 从 transcript 自动生成 session 日志的「机械部分」。

这是 K2 的实现。原工程要求模型在每次会话结束时手写 8 段日志（改了什么、
跑了什么命令、工时、成本、上下文……），230 个会话写了 1.86 MB。其中绝大多数
内容是机械事实 —— 模型是在用推理算力誊写 transcript 里已经有的东西。

机械事实交给机器：工具调用、改动文件、执行的命令、token 消耗，全部自动抽取。
模型只写机器写不出来的那一段 —— 决策与教训 —— 硬上限 1 KB。

用法:
  ratchet-digest --transcript <path> [--session N]         # 渲染到 stdout
  ratchet-digest --transcript <path> --session N --out     # 落盘到 .ratchet/log/
  echo '<hook payload>' | ratchet-digest --hook            # SessionEnd hook 通路

落盘命名恒为 .ratchet/log/{YYYY-MM-DD}-s{N}.md，hook 与 --out 共用同一套 ——
命名权在机制手里，调用方无从干预（GitHub #4：手动重定向曾造出无日期前缀的
s-1.md，与 hook 的约定分叉；`--out` 是开关不是路径，就是为了不留这个口子）。
不带 --out 时只渲染到 stdout，由调用方处置。
"""
import argparse
import datetime
import json
import os
import re
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "lib"))
import transcript  # noqa: E402
from paths import PathConflict, ensure_dir  # noqa: E402

# 噪声：查看类命令，日志不需要（日志要的是「做了什么」，不是终端回放）
_NOISE = re.compile(r"^(ls|cat|head|tail|pwd|echo|wc|find|grep|which|printf|chmod|cd)\b|^git (status|log|diff|show)\b")
# 脚手架：变量赋值、set 选项、控制流、heredoc 内容 —— 都不是「命令」
_SCAFFOLD = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*=|^set\s+[-+]|^(if|then|else|fi|for|do|done|while|EOF|PY|\}|\{)\b|^#")
MAX_CMDS = 8
MAX_FILES = 12


def signal_commands(cmds: list[str]) -> list[str]:
    """抽出有信号的命令。

    首版的 bug：直接取多行脚本的第一行，结果抽出来全是 `TDIR=...` `set -u` 这类
    变量赋值。真正的命令往往在脚本中间。改为逐行扫描、剔除脚手架行，取第一条实质命令。
    """
    out = []
    for block in cmds:
        picked = None
        for ln in block.splitlines():
            ln = ln.strip()
            if not ln or _SCAFFOLD.match(ln) or _NOISE.match(ln):
                continue
            picked = ln
            break
        if not picked:
            continue
        if len(picked) > 100:
            picked = picked[:97] + "..."
        if picked not in out:
            out.append(picked)
    return out[:MAX_CMDS]


def rel(p: str, root: str) -> str:
    try:
        return os.path.relpath(p, root)
    except ValueError:
        return p


def _in_project(p: str, root: str) -> bool:
    """项目内文件？项目外的（scratchpad 草稿、memory 等会话副产物）明细列出来
    只会淹没真实改动 —— 真实会话里它们占改动清单的 2/3（s-2 溯源）。
    注意边界：目录名可以合法地以 .. 开头（..foo），所以不能只判 startswith("..")。"""
    try:
        r = os.path.relpath(p, root)
    except ValueError:
        return False  # Windows 跨盘符，必为项目外
    return r != ".." and not r.startswith(".." + os.sep)


def render(d: transcript.Digest, session: int | None, root: str, tid: str = "") -> str:
    today = datetime.date.today().isoformat()
    sid = f"s-{session}" if session is not None else "s-?"
    L = [f"# {sid} · {today}"]
    # transcript 指纹：session_id 机制的盲区兜底。手动 CLI digest 不写 state.id，
    # 之后 /clear 触发的 hook 拿着同一条 transcript 却匹配不上 state.id，
    # 会被判成「新会话」照样吃号（s8→s9 型幽灵）。指纹嵌进日志头部、与 state 无关，
    # 手工流程破坏不了它。
    if tid:
        L.append(f"<!-- transcript:{tid} -->")
    L.append("")

    L.append("## 做了什么（自动抽取，勿手改）")
    L.append("")
    if d.files_written:
        inside = [f for f in d.files_written if _in_project(f, root)]
        n_out = len(d.files_written) - len(inside)
        L.append("**改动文件**")
        for f in inside[:MAX_FILES]:
            L.append(f"- `{rel(f, root)}`")
        if len(inside) > MAX_FILES:
            L.append(f"- …另有 {len(inside) - MAX_FILES} 个")
        if n_out:
            L.append(f"- …另改动 {n_out} 个项目外文件（scratchpad/memory 等，略）")
        L.append("")

    cmds = signal_commands(d.commands)
    if cmds:
        L.append("**关键命令**")
        L.append("")
        L.append("```bash")
        L.extend(cmds)
        L.append("```")
        L.append("")

    tools = " · ".join(f"{k}×{v}" for k, v in d.tools.most_common(8))
    L.append(f"**工具**：{tools or '（无）'}")
    L.append(f"**轮次**：{d.turns}")
    L.append(
        f"**token**：in {d.input_tokens:,} · out {d.output_tokens:,} · "
        f"cache 读 {d.cache_read:,} / 写 {d.cache_write:,} · 合计 {d.total_tokens:,}"
    )
    if d.context_window:
        L.append(f"**上下文**：{d.context_pct}% ({d.context_used:,}/{d.context_window:,})")
    L.append("")
    L.append("---")
    L.append("")
    L.append("## 决策与教训（本节由你手写，≤ 1 KB）")
    L.append("")
    L.append("> 只写机器写不出来的东西：为什么这么选、哪里判断错了、下次别再踩什么。")
    L.append("> 不要复述上面已有的机械事实。写不满不用凑。")
    L.append("")
    L.append("- ")
    L.append("")
    return "\n".join(L)


def session_id(payload: dict) -> str:
    """本次会话的唯一标识。

    两条腿走路，任一可用即可 —— 不赌单一字段：
      1. payload.session_id：官方文档列为通用字段，但 SessionEnd 的完整 schema
         文档没给全，属未实测来源。
      2. transcript 文件名：实测过 —— basename 与 transcript 内的 sessionId 完全一致。
         digest 本来就吃 transcript_path，这个来源不额外依赖任何东西。
    """
    sid = str(payload.get("session_id") or "").strip()
    if sid:
        return sid
    tp = payload.get("transcript_path") or ""
    return os.path.splitext(os.path.basename(tp))[0] if tp else ""


def _find_by_transcript(logdir: str, tid: str) -> str:
    """日志目录里已有这条 transcript 产物的日志吗？有则返回文件名。

    只读每份日志的头部 —— 标记就在标题下一行，不必读全文件。
    """
    if not os.path.isdir(logdir):
        return ""
    mark = f"<!-- transcript:{tid} -->"
    for fn in sorted(os.listdir(logdir)):
        if not fn.endswith(".md"):
            continue
        try:
            with open(os.path.join(logdir, fn), encoding="utf-8") as fh:
                head = fh.read(4096)
        except OSError:
            continue
        if mark in head:
            return fn
    return ""


def fail_visibly(msg: str) -> int:
    """留痕失败时的唯一出口：不崩会话（rc=0），但绝不静默。

    溯源：GitHub #2。原先 hook 模式的兜底 `except Exception: print("{}")` 把一切
    异常吞成空对象 —— 退出码 0、stdout 干净、stderr 空。用户以为天天在留痕，
    实际什么都没写，等需要翻历史时才发现一片空白。

    「不能把会话搞崩」的初衷是对的，代价却选错了：崩溃会被看见，静默不会。
    所以保留 rc=0，改为两路发信号：
      · systemMessage —— SessionEnd 协议允许的 universal 字段，用户当场可见
                          （依据 https://code.claude.com/docs/en/hooks；也是本脚本
                           成功路径一直在用的同一个字段）
      · stderr        —— CLI/调试可见，兜 systemMessage 被平台折叠的情况

    不写 hits.jsonl：那是 guard 命中的口径，ratchet-audit 按 rule 与已知规则对账，
    掺进非 guard 记录会污染减法审计。
    """
    print(f"ratchet-digest: {msg}", file=sys.stderr)
    json.dump({"systemMessage": f"[ratchet] 留痕失败 —— {msg}"},
              sys.stdout, ensure_ascii=False)
    print()
    return 0


def run_hook(payload: dict) -> int:
    """SessionEnd：把机械事实落盘，并标记『决策段待补』。

    不覆盖已存在的日志 —— 会话可能被 resume，重复触发不该抹掉已写的内容。
    非 ratchet 项目静默退出（plugin 装在全局，会在每个项目启动）。
    """
    root = payload.get("cwd") or os.environ.get("CLAUDE_PROJECT_DIR") or os.getcwd()
    rd = os.path.join(root, ".ratchet")
    state_p = os.path.join(rd, "state.json")
    if not os.path.isfile(state_p):
        print("{}")
        return 0

    try:
        st = json.load(open(state_p, encoding="utf-8"))
    except Exception:
        print("{}")
        return 0

    d = transcript.parse(payload.get("transcript_path", ""),
                         transcript.load_config(root).get("context_window"))
    if not d.turns:
        if d.unrecognized:
            return fail_visibly("transcript 非空但格式无法识别（可能平台 schema 已变化）")
        print("{}")
        return 0  # 空会话不留痕

    sess = st.setdefault("session", {})
    sid = session_id(payload)
    resumed = bool(sid) and sid == sess.get("id")

    logdir = os.path.join(rd, "log")

    # 指纹去重（仅拦「身份对不上」的重复）：resumed 管「同一会话再次收尾」，
    # 但手动 CLI digest 不写 state.id —— /clear 的 hook 拿着同一条 transcript、
    # sid 匹配不上，会被判成新会话照样吃号、翻 log_written=false（s8→s9 型幽灵，
    # s5/s7/s9 三犯里的最后一型）。产物已物理存在的 transcript，绝不再产第二份。
    tid = os.path.basename(payload.get("transcript_path", "") or "")
    if not resumed and tid:
        dup = _find_by_transcript(logdir, tid)
        if dup:
            json.dump(
                {"systemMessage": f"[ratchet] 本 transcript 已留痕为 {dup}，跳过重复 digest"},
                sys.stdout, ensure_ascii=False,
            )
            print()
            return 0

    try:
        ensure_dir(logdir)
    except PathConflict as e:
        return fail_visibly(str(e))
    today = datetime.date.today().isoformat()

    # 首版的 bug：n 无脑取 last+1，然后 `if not exists(fp)` 静默跳过写入，
    # 却照样把 last 递增、照样报告「已生成日志草稿」。两个后果：
    #   · 谎报 —— 什么都没写，却说写了（违反纪律三：诚实）
    #   · 同一个会话被 resume，就白吃一个编号，日志序列里留下空洞
    # 根因是这个计数器不知道「会话」是什么，只会做加法。所以给它一个身份。
    if resumed:
        # 同一会话再次收尾（resume / clear）：不吃新编号。
        n = int(sess.get("last") or 0)
        fp = os.path.join(logdir, f"{today}-s{n}.md")
        wrote = not os.path.exists(fp)
        if wrote:  # 上次没写成（比如那次是空会话），补上
            open(fp, "w", encoding="utf-8").write(render(d, n, root, tid))
    else:
        # 新会话：编号本不该撞。撞了说明 state 与 log 不同步（state 被手工改过？）——
        # 顺延到下一个空位，绝不覆盖别人的日志，也绝不静默跳过。
        n = int(sess.get("last") or 0) + 1
        fp = os.path.join(logdir, f"{today}-s{n}.md")
        while os.path.exists(fp):
            n += 1
            fp = os.path.join(logdir, f"{today}-s{n}.md")
        open(fp, "w", encoding="utf-8").write(render(d, n, root, tid))
        wrote = True

    sess["last"] = n
    if sid:
        sess["id"] = sid
    sess["last_date"] = today
    if not resumed:
        sess["log_written"] = False  # 决策段还没写 —— 下次起手简报会顶着 ⚠️ 提醒
    st["updated_at"] = datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")
    with open(state_p, "w", encoding="utf-8") as fh:
        json.dump(st, fh, ensure_ascii=False, indent=2)

    # SessionEnd 没有 decision control，也不接受 hookSpecificOutput / additionalContext ——
    # 它是纯副作用事件，只认 universal 字段（systemMessage / suppressOutput / …）。
    # 见 https://code.claude.com/docs/en/hooks
    #
    # 首版吐了 hookSpecificOutput.additionalContext，平台校验直接失败：
    #   SessionEnd hook failed: Hook JSON output validation failed — (root): Invalid input
    # 日志其实落盘了（副作用在这行之前就发生了），但每次收尾都往用户终端喷一行红字。
    # 这是本项目第二次栽在「凭印象写 hook 输出协议」上（第一次是 PostToolUse 误用
    # permissionDecision）—— 所以现在每个 hook 事件的输出格式都有测试钉死。
    #
    # 只报告真实发生的事。文件没写就不许说「已生成」—— 那是把留痕的假象卖给用户，
    # 而留痕是 brief 和 slim 共同的地基。
    rp = os.path.relpath(fp, root)
    msg = (f"[ratchet] 已生成 s-{n} 日志草稿：{rp}（决策段待补）" if wrote
           else f"[ratchet] s-{n} 日志草稿已存在，未覆盖：{rp}")
    json.dump({"systemMessage": msg}, sys.stdout, ensure_ascii=False)
    print()
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("--transcript")
    ap.add_argument("--session", type=int)
    ap.add_argument("--hook", action="store_true")
    # 开关，不接路径 —— 命名权不下放。见模块 docstring 与 GitHub #4。
    ap.add_argument("--out", action="store_true",
                    help="落盘到 .ratchet/log/{today}-s{N}.md，而不是渲染到 stdout")
    ap.add_argument("--root", default=os.environ.get("CLAUDE_PROJECT_DIR") or os.getcwd())
    a = ap.parse_args()

    if a.hook:
        try:
            payload = json.load(sys.stdin)
        except Exception:
            print("{}")
            return 0
        try:
            return run_hook(payload)
        except Exception as e:
            # 留痕失败绝不能把会话搞崩 —— 但也绝不能悄无声息（GitHub #2）。
            # rc 仍是 0，信号走 fail_visibly 的 systemMessage + stderr 两路。
            return fail_visibly(f"{e.__class__.__name__}: {e}")

    path = a.transcript
    if not path and not sys.stdin.isatty():
        try:
            path = json.load(sys.stdin).get("transcript_path", "")
        except Exception:
            path = ""
    if not path:
        print("ratchet-digest: 需要 --transcript 或 hook stdin payload", file=sys.stderr)
        return 1

    d = transcript.parse(path)
    body = render(d, a.session, a.root, os.path.basename(path))

    if not a.out:
        sys.stdout.write(body)
        return 0

    # 落盘：命名恒为 {today}-s{N}.md，与 hook 同一套。调用方给不了文件名。
    n = a.session
    if n is None:
        st_p = os.path.join(a.root, ".ratchet", "state.json")
        try:
            n = int((json.load(open(st_p, encoding="utf-8")).get("session") or {}).get("last") or 0)
        except Exception:
            n = 0
        if not n:
            print("ratchet-digest: --out 需要会话编号 —— 给 --session N，"
                  "或先让 state.json 的 session.last 有值", file=sys.stderr)
            return 1

    logdir = os.path.join(a.root, ".ratchet", "log")
    try:
        ensure_dir(logdir)
    except PathConflict as e:
        print(f"ratchet-digest: {e}", file=sys.stderr)
        return 1

    fp = os.path.join(logdir, f"{datetime.date.today().isoformat()}-s{n}.md")
    if os.path.exists(fp):
        # 留痕只增不抹 —— 覆盖是数据丢失，不是「更新」
        print(f"ratchet-digest: {fp} 已存在，不覆盖。\n"
              f"  要另起一篇：换 --session 编号\n"
              f"  要接着写：直接编辑该文件（决策段本来就该手写）", file=sys.stderr)
        return 1

    with open(fp, "w", encoding="utf-8") as fh:
        fh.write(body)
    print(f"已写入 {os.path.relpath(fp, a.root)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
