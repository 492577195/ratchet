#!/usr/bin/env python3
"""
ratchet-guard — 危险动作拦截。PreToolUse hook（Claude Code 与 Codex 都支持）。

纪律「可逆性」的硬门禁实现。原工程把它写成一条 CLAUDE.md 里的 YOU MUST，
靠模型自觉；这里把它下沉成确定性代码 —— 模型绕不过去。

两级：
  deny — 不可逆且高危。直接拒绝，不给商量余地。
  ask  — 可能危险。转人工确认。

其中一类值得单独说：**Slopsquatting**（AI 幻觉依赖投毒）。
模型为了让方案看起来合理，会虚构出根本不存在的包名（fastparserx 这种）。
攻击者监控主流模型的幻觉偏好，抢先在 npm/PyPI 注册这些包名并植入恶意载荷。
AI 一句 `npm install` 就中招，post-install 脚本在毫秒级窃取云凭据并外传。
所以：**任何不在依赖清单里的包安装，一律转人工确认。**

平台差异：CC 的工具叫 Bash，Codex 走 shell exec，工具名不同。
因此本脚本**不依赖工具名**，只从 payload 里尽力提取命令文本。

协议（两平台一致，P0 实测确认）：
  stdin  : {"tool_name": "...", "tool_input": {...}}
  stdout : {"hookSpecificOutput": {"hookEventName": "PreToolUse",
            "permissionDecision": "deny|ask", "permissionDecisionReason": "..."}}
  放行时输出 {} 并 exit 0。**决策一律走 JSON body，不用退出码** —— 退出码非 0
  会被平台当成 hook 自身故障，而不是「拒绝」。
"""
import datetime
import json
import os
import re
import shlex
import sys

# 每条规则带 id —— 命中会被记录，供 /ratchet:slim 做减法审计。
# 长期零命中的规则是化石（问题多半已被工具根治），该淘汰；
# 高频命中说明它是真问题，值得留着。没有命中数据，减法就只能靠拍脑袋。

# ── deny：不可逆的破坏 ───────────────────────────────────────────────
DENY = [
    ("rm-rf",
     re.compile(r"\brm\s+(-[a-zA-Z]*\s+)*-[a-zA-Z]*[rR][a-zA-Z]*f|\brm\s+(-[a-zA-Z]*\s+)*-[a-zA-Z]*f[a-zA-Z]*[rR]"),
     "递归强制删除（rm -rf）。要删就明确列出路径，或让用户自己执行。"),
    ("push-force",
     re.compile(r"\bgit\s+push\b.*(--force\b(?!-with-lease)|(?<![\w-])-f(?![\w-]))"),
     "git push --force 会覆写远端历史，不可逆。改用 --force-with-lease，或请用户确认。"),
    ("reset-hard",
     re.compile(r"\bgit\s+reset\s+--hard\b"),
     "git reset --hard 会丢弃工作区改动，不可逆。先 stash 或 commit。"),
    ("checkout-discard",
     re.compile(r"\bgit\s+checkout\s+--\s"),
     "git checkout -- <path> 会丢弃该文件的所有未提交改动，不可逆。"),
    ("git-clean",
     re.compile(r"\bgit\s+clean\s+(-[a-zA-Z]*\s+)*-[a-zA-Z]*f"),
     "git clean -f 会删除未跟踪文件，不可逆。先 git clean -n 看看会删什么。"),
    ("block-device",
     re.compile(r">\s*/dev/(sd|disk|nvme)"),
     "直接写块设备。"),
    ("mkfs-dd",
     re.compile(r"\bmkfs\b|\bdd\s+.*\bof=/dev/"),
     "格式化 / 裸写磁盘。"),
]

# ── ask：可能危险，转人工 ────────────────────────────────────────────
ASK = [
    ("push",
     re.compile(r"\bgit\s+push\b(?!.*--dry-run)"),
     "push 是对外动作，请确认目标分支与远端。"),
    ("rewrite-history",
     re.compile(r"\bgit\s+rebase\b|\bgit\s+filter-branch\b|\bgit\s+reflog\s+expire\b"),
     "改写历史。"),
    ("chmod-777",
     re.compile(r"\bchmod\s+(-[a-zA-Z]+\s+)*777\b"),
     "chmod 777 放开全部权限。"),
    ("curl-pipe-sh",
     re.compile(r"\bcurl\b[^|]*\|\s*(sudo\s+)?(ba)?sh\b|\bwget\b[^|]*\|\s*(sudo\s+)?(ba)?sh\b"),
     "把网络内容直接管进 shell 执行 —— 无法审计执行了什么。先下载、看一眼、再跑。"),
    ("sudo",
     re.compile(r"\bsudo\b"),
     "提权操作。"),
]

# ── Slopsquatting：依赖安装 ─────────────────────────────────────────
INSTALL = re.compile(
    r"\b(?:npm|pnpm|yarn|bun)\s+(?:install|add|i)\s+(?P<js>[^\s;&|]+)"
    r"|\b(?:pip|pip3|uv\s+pip)\s+install\s+(?P<py>[^\s;&|]+)"
)
# 这些不是包名
_NOT_PKG = re.compile(r"^-|^\.|/|^(?:git\+|https?:)")

MANIFESTS = ("package.json", "requirements.txt", "pyproject.toml", "Pipfile", "package-lock.json", "uv.lock")


def declared_deps(root: str) -> str:
    """把项目依赖清单读成一坨文本，用于判断包名是否是「已声明的」。"""
    blob = []
    for m in MANIFESTS:
        p = os.path.join(root, m)
        try:
            with open(p, encoding="utf-8", errors="replace") as fh:
                blob.append(fh.read())
        except OSError:
            pass
    return "\n".join(blob)


def check_install(cmd: str, root: str) -> str | None:
    """返回 ask 理由；无风险返回 None。"""
    deps = None
    for m in INSTALL.finditer(cmd):
        pkg = m.group("js") or m.group("py") or ""
        if not pkg or _NOT_PKG.search(pkg):
            continue
        bare = re.split(r"[@=<>~^]", pkg.lstrip("@"), maxsplit=1)[0]
        if not bare:
            continue
        if deps is None:
            deps = declared_deps(root)
        if re.search(rf'["\'/\s]{re.escape(bare)}["\'\s=<>~^@]', deps):
            continue  # 依赖清单里有，是已声明的依赖
        return (
            f"安装了依赖清单里没有的包 `{bare}`。\n"
            f"Slopsquatting 风险：模型会幻觉出不存在的包名，攻击者抢注同名恶意包，"
            f"post-install 脚本可在毫秒级窃取本机凭据。\n"
            f"请先确认 `{bare}` 确实存在、是你要的那个包、且维护者可信，再放行。"
        )
    return None


# 这些命令会把参数当代码执行 —— 危险串藏在它们的参数里，就是真的要跑。
# 包装器（env/xargs/time/nohup/sudo）后面跟的是真命令，同样按原文看。
INTERPRETERS = {
    "sh", "bash", "zsh", "dash", "ksh", "fish", "eval",
    "python", "python3", "node", "ruby", "perl", "php",
    "env", "xargs", "time", "nohup", "sudo", "ssh", "docker",
}


def scan_text(cmd: str) -> str:
    """返回真正用于危险模式匹配的文本。

    首版对整条命令原文做匹配，于是 `printf 'rm -rf x' > f` 这种只是**提到**危险串、
    根本不执行它的命令也被 deny —— 写文档、打补丁、grep 代码全会被拦。
    动辄误拦的门禁会被用户直接关掉，那时保护等于零。

    但漏拦远比误拦严重，所以这里只收窄一格，其余一律保守回退到原文：
      - heredoc（<<）           → 原文。内容会被喂进解释器执行，看不进去
      - 引号不闭合 / 切词失败    → 原文。看不懂就别自作聪明
      - 命令位是解释器或包装器   → 原文。它们的参数就是要执行的代码
      - 普通命令（printf/grep…）→ 剔除「被引号包起来的字面量」再匹配

    唯一放行的，是危险串纯粹作为普通命令的引号字符串参数出现。
    含命令替换（$(…) / 反引号）的 token 不剔除 —— 那里面的东西是会跑的。
    """
    if "<<" in cmd:
        return cmd

    # 分隔符必须原样留在重建结果里 —— curl-pipe-sh 这类规则正是靠管道符识别的，
    # 切掉分隔符会让它们悄悄失效（首版这么写，`curl … | sh` 直接从 ask 掉成 allow）。
    out = []
    for sc in re.split(r"(\|\||&&|[;|&\n])", cmd):
        if re.fullmatch(r"\|\||&&|[;|&\n]", sc or ""):
            out.append(sc)          # 分隔符原样保留
            continue
        sc = (sc or "").strip()
        if not sc:
            continue
        try:
            toks = shlex.split(sc)
        except ValueError:
            out.append(sc)          # 引号不闭合 → 保守
            continue
        if not toks:
            continue
        if os.path.basename(toks[0]) in INTERPRETERS:
            out.append(sc)          # 参数即代码 → 保守
            continue
        out.append(" ".join(
            t for t in toks
            if not re.search(r"\s", t) or re.search(r"\$\(|`", t)
        ))
    return " ".join(out)


def extract_command(payload: dict) -> str:
    """从 payload 里尽力挖出命令文本。

    不依赖工具名 —— CC 的工具叫 Bash，Codex 走 shell exec，字段也可能不同。
    宁可多扫几个字段，也不要因为平台改了个键名就悄悄失效。
    """
    ti = payload.get("tool_input") or payload.get("input") or {}
    if isinstance(ti, str):
        return ti
    if not isinstance(ti, dict):
        return ""
    for k in ("command", "cmd", "script", "shell_command"):
        v = ti.get(k)
        if isinstance(v, str) and v:
            return v
        if isinstance(v, list):
            return " ".join(str(x) for x in v)
    return ""


def record_hit(root: str, rule_id: str, decision: str) -> None:
    """记一笔命中。这是棘爪释放的数据基础 —— 没有命中统计，减法就只能靠拍脑袋。

    失败绝不能影响拦截本身：审计是次要的，门禁是主要的。
    """
    try:
        rd = os.path.join(root, ".ratchet")
        if not os.path.isdir(rd):
            return
        line = json.dumps(
            {"rule": rule_id, "decision": decision,
             "at": datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")},
            ensure_ascii=False,
        )
        with open(os.path.join(rd, "hits.jsonl"), "a", encoding="utf-8") as fh:
            fh.write(line + "\n")
    except Exception:
        pass


def emit(decision: str | None, reason: str = "", rule_id: str = "", root: str = "") -> int:
    if decision is None:
        print("{}")
        return 0
    if rule_id and root:
        record_hit(root, rule_id, decision)
    json.dump(
        {"hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": decision,
            "permissionDecisionReason": f"[ratchet-guard] {reason}",
        }},
        sys.stdout, ensure_ascii=False,
    )
    print()
    return 0  # 决策走 JSON body，退出码恒 0（非 0 会被当成 hook 故障）


def main() -> int:
    if "--list-rules" in sys.argv:
        json.dump(
            {"deny": [r[0] for r in DENY], "ask": [r[0] for r in ASK] + ["slopsquatting"]},
            sys.stdout, ensure_ascii=False,
        )
        print()
        return 0

    try:
        payload = json.load(sys.stdin)
    except Exception:
        return emit(None)  # 读不懂就放行，guard 不该把会话卡死

    cmd = extract_command(payload)
    if not cmd:
        return emit(None)

    root = payload.get("cwd") or os.environ.get("CLAUDE_PROJECT_DIR") or os.getcwd()
    scan = scan_text(cmd)

    for rid, pat, why in DENY:
        if pat.search(scan):
            return emit("deny", why, rid, root)

    slop = check_install(scan, root)
    if slop:
        return emit("ask", slop, "slopsquatting", root)

    for rid, pat, why in ASK:
        if pat.search(scan):
            return emit("ask", why, rid, root)

    return emit(None)


if __name__ == "__main__":
    sys.exit(main())
