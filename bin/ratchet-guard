#!/usr/bin/env python3
"""
ratchet-guard — 危险动作拦截。PreToolUse hook（Claude Code 与 Codex 都支持）。

纪律「可逆性」的硬门禁实现。原工程把它写成一条 CLAUDE.md 里的 YOU MUST，
靠模型自觉；这里把它下沉成确定性代码 —— 模型绕不过去。

两级：
  deny — 不可逆且高危。直接拒绝，不给商量余地。
  ask  — 可能危险。转人工确认。

其中一类值得单独说：**Slopsquatting**（AI 幻觉依赖投毒）。
模型为了让方案看起来合理，会虚构出根本不存在的包名（fastparserx 这种）。
攻击者监控主流模型的幻觉偏好，抢先在 npm/PyPI 注册这些包名并植入恶意载荷。
AI 一句 `npm install` 就中招，post-install 脚本在毫秒级窃取云凭据并外传。
所以：**任何不在依赖清单里的包安装，一律转人工确认。**

平台差异：CC 的工具叫 Bash，Codex 走 shell exec，工具名不同。
因此本脚本**不依赖工具名**，只从 payload 里尽力提取命令文本。

协议（两平台一致，P0 实测确认）：
  stdin  : {"tool_name": "...", "tool_input": {...}}
  stdout : {"hookSpecificOutput": {"hookEventName": "PreToolUse",
            "permissionDecision": "deny|ask", "permissionDecisionReason": "..."}}
  放行时输出 {} 并 exit 0。**决策一律走 JSON body，不用退出码** —— 退出码非 0
  会被平台当成 hook 自身故障，而不是「拒绝」。
"""
import datetime
import json
import os
import re
import shlex
import sys

# 每条规则带 id —— 命中会被记录，供 /ratchet:slim 做减法审计。
# 长期零命中的规则是化石（问题多半已被工具根治），该淘汰；
# 高频命中说明它是真问题，值得留着。没有命中数据，减法就只能靠拍脑袋。

# ── deny：不可逆的破坏 ───────────────────────────────────────────────
DENY = [
    ("rm-rf",
     re.compile(r"\brm\s+(-[a-zA-Z]*\s+)*-[a-zA-Z]*[rR][a-zA-Z]*f|\brm\s+(-[a-zA-Z]*\s+)*-[a-zA-Z]*f[a-zA-Z]*[rR]"),
     "递归强制删除（rm -rf）。要删就明确列出路径，或让用户自己执行。"),
    ("push-force",
     re.compile(r"\bgit\s+push\b.*(--force\b(?!-with-lease)|(?<![\w-])-f(?![\w-]))"),
     "git push --force 会覆写远端历史，不可逆。改用 --force-with-lease，或请用户确认。"),
    ("reset-hard",
     re.compile(r"\bgit\s+reset\s+--hard\b"),
     "git reset --hard 会丢弃工作区改动，不可逆。先 stash 或 commit。"),
    ("checkout-discard",
     re.compile(r"\bgit\s+checkout\s+--\s"),
     "git checkout -- <path> 会丢弃该文件的所有未提交改动，不可逆。"),
    ("git-clean",
     re.compile(r"\bgit\s+clean\s+(-[a-zA-Z]*\s+)*-[a-zA-Z]*f"),
     "git clean -f 会删除未跟踪文件，不可逆。先 git clean -n 看看会删什么。"),
    ("block-device",
     re.compile(r">\s*/dev/(sd|disk|nvme)"),
     "直接写块设备。"),
    ("mkfs-dd",
     re.compile(r"\bmkfs\b|\bdd\s+.*\bof=/dev/"),
     "格式化 / 裸写磁盘。"),
]

# ── ask：可能危险，转人工 ────────────────────────────────────────────
ASK = [
    ("push",
     re.compile(r"\bgit\s+push\b(?!.*--dry-run)"),
     "push 是对外动作，请确认目标分支与远端。"),
    ("rewrite-history",
     re.compile(r"\bgit\s+rebase\b|\bgit\s+filter-branch\b|\bgit\s+reflog\s+expire\b"),
     "改写历史。"),
    ("chmod-777",
     re.compile(r"\bchmod\s+(-[a-zA-Z]+\s+)*777\b"),
     "chmod 777 放开全部权限。"),
    ("curl-pipe-sh",
     re.compile(r"\bcurl\b[^|]*\|\s*(sudo\s+)?(ba)?sh\b|\bwget\b[^|]*\|\s*(sudo\s+)?(ba)?sh\b"),
     "把网络内容直接管进 shell 执行 —— 无法审计执行了什么。先下载、看一眼、再跑。"),
    ("sudo",
     re.compile(r"\bsudo\b"),
     "提权操作。"),
]

# ── Slopsquatting：依赖安装 ─────────────────────────────────────────
INSTALL = re.compile(
    r"\b(?:npm|pnpm|yarn|bun)\s+(?:install|add|i)\s+(?P<js>[^\s;&|]+)"
    r"|\b(?:pip|pip3|uv\s+pip)\s+install\s+(?P<py>[^\s;&|]+)"
)
# 这些不是包名
_NOT_PKG = re.compile(r"^-|^\.|/|^(?:git\+|https?:)")

MANIFESTS = ("package.json", "requirements.txt", "pyproject.toml", "Pipfile", "package-lock.json", "uv.lock")


def declared_deps(root: str) -> str:
    """把项目依赖清单读成一坨文本，用于判断包名是否是「已声明的」。"""
    blob = []
    for m in MANIFESTS:
        p = os.path.join(root, m)
        try:
            with open(p, encoding="utf-8", errors="replace") as fh:
                blob.append(fh.read())
        except OSError:
            pass
    return "\n".join(blob)


def check_install(cmd: str, root: str) -> str | None:
    """返回 ask 理由；无风险返回 None。"""
    deps = None
    for m in INSTALL.finditer(cmd):
        pkg = m.group("js") or m.group("py") or ""
        if not pkg or _NOT_PKG.search(pkg):
            continue
        bare = re.split(r"[@=<>~^]", pkg.lstrip("@"), maxsplit=1)[0]
        if not bare:
            continue
        if deps is None:
            deps = declared_deps(root)
        if re.search(rf'["\'/\s]{re.escape(bare)}["\'\s=<>~^@]', deps):
            continue  # 依赖清单里有，是已声明的依赖
        return (
            f"安装了依赖清单里没有的包 `{bare}`。\n"
            f"Slopsquatting 风险：模型会幻觉出不存在的包名，攻击者抢注同名恶意包，"
            f"post-install 脚本可在毫秒级窃取本机凭据。\n"
            f"请先确认 `{bare}` 确实存在、是你要的那个包、且维护者可信，再放行。"
        )
    return None


# 这些命令会把参数当代码执行 —— 危险串藏在它们的参数里，就是真的要跑。
# 包装器（env/xargs/time/nohup/sudo）后面跟的是真命令，同样按原文看。
INTERPRETERS = {
    "sh", "bash", "zsh", "dash", "ksh", "fish", "eval",
    "python", "python3", "node", "ruby", "perl", "php",
    "env", "xargs", "time", "nohup", "sudo", "ssh", "docker",
}


def scan_text(cmd: str) -> tuple[str, str | None]:
    """返回 (用于危险模式匹配的文本, 保守回退的原因或 None)。

    首版对整条命令原文做匹配，于是 `printf 'rm -rf x' > f` 这种只是**提到**危险串、
    根本不执行它的命令也被 deny —— 写文档、打补丁、grep 代码全会被拦。
    动辄误拦的门禁会被用户直接关掉，那时保护等于零。

    但漏拦远比误拦严重，所以这里只收窄一格，其余一律保守回退到原文：
      - heredoc（<<）           → 原文。内容会被喂进解释器执行，看不进去
      - 引号不闭合 / 切词失败    → 原文。看不懂就别自作聪明
      - 命令位是解释器或包装器   → 原文。它们的参数就是要执行的代码
      - 普通命令（printf/grep…）→ 剔除「被引号包起来的字面量」再匹配

    唯一放行的，是危险串纯粹作为普通命令的引号字符串参数出现。
    含命令替换（$(…) / 反引号）的 token 不剔除 —— 那里面的东西是会跑的。

    **回退原因要带出去。** 首版只返回文本，于是回退触发的拦截和真·危险动作的
    拦截长得一模一样：命令里只是**提到** rm -rf（写 commit message、写文档），
    却收到「递归强制删除。要删就明确列出路径」—— 理由完全对不上现场。
    实测后果：连读得懂源码的 agent 都误判成 guard 有 bug，转头提了个「放松
    heredoc 匹配」的错误修法。理由说不清楚的门禁，会自己训练用户去绕过它。
    """
    if "<<" in cmd:
        return cmd, "heredoc"

    # 分隔符必须原样留在重建结果里 —— curl-pipe-sh 这类规则正是靠管道符识别的，
    # 切掉分隔符会让它们悄悄失效（首版这么写，`curl … | sh` 直接从 ask 掉成 allow）。
    out = []
    fallback = None
    for sc in re.split(r"(\|\||&&|[;|&\n])", cmd):
        if re.fullmatch(r"\|\||&&|[;|&\n]", sc or ""):
            out.append(sc)          # 分隔符原样保留
            continue
        sc = (sc or "").strip()
        if not sc:
            continue
        try:
            toks = shlex.split(sc)
        except ValueError:
            out.append(sc)          # 引号不闭合 → 保守
            fallback = fallback or "unbalanced-quote"
            continue
        if not toks:
            continue
        if os.path.basename(toks[0]) in INTERPRETERS:
            out.append(sc)          # 参数即代码 → 保守
            fallback = fallback or "interpreter"
            continue
        out.append(" ".join(
            t for t in toks
            if not re.search(r"\s", t) or re.search(r"\$\(|`", t)
        ))
    return " ".join(out), fallback


# 回退触发拦截时，附在理由后面。目的不是放行，是让人看懂**为什么**被拦，
# 以及**正确的出路是什么** —— 否则唯一看起来管用的出路就是 --no-verify。
FALLBACK_NOTE = {
    "heredoc": (
        "\n\n⚠️ 注意：这条命令含 heredoc（<<），guard 无法安全判断里面的内容会不会被"
        "喂进解释器执行，因此按**原文**匹配危险模式。\n"
        "如果那串危险文本只是文档 / commit message / 字符串内容，并不真的执行 —— "
        "把它写进文件，再用 `-F <file>`（git commit）或从文件读入，即可正常通过。\n"
        "这不是 bug，是有意的保守：漏拦远比误拦严重。"
    ),
    "unbalanced-quote": (
        "\n\n⚠️ 注意：这条命令引号不闭合，guard 无法切词，因此按**原文**匹配危险模式。"
        "先把引号配平再试。"
    ),
    "interpreter": (
        "\n\n⚠️ 注意：命令位是解释器 / 包装器（sh、python、eval、xargs…），"
        "它的参数就是要执行的代码，因此按**原文**匹配，不剔除引号内字面量。"
    ),
}


def is_apply_patch(payload: dict) -> bool:
    """这条调用是不是 Codex 的 apply_patch。

    apply_patch 写文件、不执行 shell，其 tool_input.command 是**补丁正文**而非命令。
    优先看 tool_name，兜底看正文是否以 `*** Begin Patch` 开头（防平台改了工具名）。
    """
    if payload.get("tool_name") == "apply_patch":
        return True
    ti = payload.get("tool_input")
    if isinstance(ti, dict):
        c = ti.get("command")
        if isinstance(c, str) and c.lstrip().startswith("*** Begin Patch"):
            return True
    return False


# apply_patch 把目标路径埋在补丁头里（头字面量 *** Add/Update/Delete File: 与
# *** Move to: 均从 codex 二进制实证）。这是它唯一的路径来源 —— 没有 file_path 键。
_PATCH_TARGET = re.compile(r"^\*\*\* (?:Add|Update|Delete) File:\s*(.+?)\s*$", re.M)
_PATCH_MOVE = re.compile(r"^\*\*\* Move to:\s*(.+?)\s*$", re.M)


def apply_patch_paths(payload: dict) -> list[str]:
    """apply_patch 补丁要写 / 删 / 移到的相对路径（相对 cwd）。"""
    ti = payload.get("tool_input") or {}
    patch = ti.get("command", "") if isinstance(ti, dict) else ""
    if not isinstance(patch, str):
        return []
    hits = _PATCH_TARGET.findall(patch) + _PATCH_MOVE.findall(patch)
    return [p for p in (s.strip().strip("\"'") for s in hits) if p]


def extract_command(payload: dict) -> str:
    """从 payload 里尽力挖出命令文本。

    不依赖工具名 —— CC 的工具叫 Bash，Codex 走 shell exec，字段也可能不同。
    宁可多扫几个字段，也不要因为平台改了个键名就悄悄失效。
    """
    # apply_patch 写文件、不执行 shell —— 它的 tool_input.command 是补丁正文，不是命令。
    # 首版把补丁正文喂进危险模式扫描，于是「往文件加一行含 rm -rf 字样」的补丁被误判成
    # 「要执行 rm -rf」而 deny（实测复现）。补丁的正确防线是只读区（见 check_readonly），
    # 不是 shell 危险扫描 —— 所以这里直接返回空，让危险扫描 / Slopsquatting 一律跳过它。
    if is_apply_patch(payload):
        return ""
    ti = payload.get("tool_input") or payload.get("input") or {}
    if isinstance(ti, str):
        return ti
    if not isinstance(ti, dict):
        return ""
    for k in ("command", "cmd", "script", "shell_command"):
        v = ti.get(k)
        if isinstance(v, str) and v:
            return v
        if isinstance(v, list):
            return " ".join(str(x) for x in v)
    return ""


# ── 只读区 ──────────────────────────────────────────────────────────
# 在 .ratchet/config.json 里声明 AI 只许读、不许写的目录：
#
#     { "readonly_paths": ["../ratchet-eval"] }
#
# 为什么需要它：当 AI 被交给一个「跑测试 → 修代码 → 重跑」的自动循环时，
# 它迟早会发现**改判据比改代码容易**。把红的用例改绿，循环就"成功"了。
# 这不是恶意，是优化压力的自然走向 —— 所以不能靠在宪法里写一句「不许改测试」。
# 能机器化的约束就不该写成文字，判据本身更得守。
#
# 边界（诚实说）：Bash 那条是启发式，挡的是「顺手就改了」，不是「铁了心要改」。
# 真正兜底的是循环收尾时校验判据仓的 git 完整性 —— 那是确定性的，绕不过去。

WRITE_TOOLS = {"Edit", "Write", "NotebookEdit", "MultiEdit"}

# 写入型命令。故意不含 python/node —— 它们确实能写文件，但把它们算成写入动词，
# 就会连「运行只读区里的脚本」都拦掉（自循环恰恰需要跑 eval 本身）。
# 那种误伤会让人直接关掉整个机制，那时保护等于零。
WRITE_CMDS = re.compile(r"\b(rm|mv|cp|touch|mkdir|tee|dd|truncate|chmod|chown)\b")
SED_INPLACE = re.compile(r"\bsed\b[^;|&]*\s-i")
GIT_WRITE = re.compile(r"\bgit\b[^;|&]*\b(commit|add|checkout|reset|restore|apply|rm|mv|stash|push)\b")


def readonly_roots(root: str) -> list[str]:
    cfg = os.path.join(root, ".ratchet", "config.json")
    try:
        with open(cfg, encoding="utf-8") as fh:
            paths = json.load(fh).get("readonly_paths") or []
    except (OSError, json.JSONDecodeError, AttributeError):
        return []

    out = []
    for p in paths:
        if isinstance(p, str) and p:
            out.append(os.path.realpath(os.path.join(root, os.path.expanduser(p))))

    # 自封：声明了只读区，这份配置自己也就成了只读区。
    #
    # 首版漏了这条 —— 只读区保护了判据，却没保护自己。AI 只要把 config.json 里的
    # readonly_paths 删掉，约束就没了，然后回头随便改判据。实测四种姿势全部得手：
    # Write 覆盖、Edit 改键名、重定向覆盖，一个没拦住。
    #
    # 一个 AI 能自行解除的约束，等于没有约束。
    #
    # 用户仍然改得动：手动编辑文件不经过 hook。挡的是 AI 的工具调用。
    if out:
        out.append(os.path.realpath(cfg))

        # 门禁自己也得锁上。
        #
        # 只锁掉 config 是不够的：AI 可以绕开配置，直接把 plugin cache 里的
        # ratchet-guard 覆盖成一个永远放行的空壳 —— 下次会话所有约束一起消失。
        # 那是最直接的攻击面，而且成本极低。
        #
        # 只在 guard 跑自 plugin cache 时锁（即「已安装」的那份）。
        # 用 --plugin-dir 指向工作树的开发模式不锁 —— 否则没法开发 ratchet 自己。
        me = os.path.realpath(__file__)
        if os.sep + ".claude" + os.sep + "plugins" + os.sep in me:
            out.append(os.path.dirname(os.path.dirname(me)))  # plugin 根目录

    return out


def _under(path: str, roots: list[str]) -> str | None:
    """path 落在哪个只读区里。"""
    ap = os.path.realpath(path)
    for r in roots:
        if ap == r or ap.startswith(r + os.sep):
            return r
    return None


def write_targets(cmd: str) -> list[str]:
    """命令想**写**到哪些路径去。

    只收写入目标，不收所有出现过的路径 —— 否则 `cat ro/x.py > /tmp/y`（读只读区、
    写临时文件）和 `./ro/bin/tool --run`（运行只读区里的程序）都会被误拦。
    """
    t = []

    # 重定向：> target、>> target
    t += re.findall(r">>?\s*([^\s;|&<>]+)", cmd)

    # 写入型命令的参数（跳过选项）
    for m in re.finditer(r"\b(?:rm|mv|cp|touch|mkdir|tee|truncate|chmod|chown)\b([^;|&]*)", cmd):
        for tok in m.group(1).split():
            if not tok.startswith("-"):
                t.append(tok.strip("\"'"))

    # sed -i：就地改写，目标是它的文件参数
    for m in SED_INPLACE.finditer(cmd):
        tail = cmd[m.end():]
        for tok in tail.split():
            if not tok.startswith("-"):
                t.append(tok.strip("\"'"))

    return [x for x in t if x]


def check_readonly(payload: dict, root: str) -> str | None:
    roots = readonly_roots(root)
    if not roots:
        return None

    ti = payload.get("tool_input") or {}
    tool = payload.get("tool_name") or ""

    # 一、文件编辑类工具 —— AI 改代码的主要通路，路径是明写的，拦得干净利落
    if tool in WRITE_TOOLS and isinstance(ti, dict):
        fp = ti.get("file_path") or ti.get("notebook_path") or ""
        if isinstance(fp, str) and fp:
            hit = _under(os.path.join(root, fp), roots)
            if hit:
                return (f"{os.path.basename(hit)} 是只读区，不能改。\n"
                        f"它是判据（或受保护的配置）—— 判据被改动，验证就失去意义。\n"
                        f"该改的是被测代码，不是尺子。")

    # 一·B、apply_patch —— Codex 的文件编辑通路。路径埋在补丁头里
    # （*** Add/Update/Delete File: / *** Move to:），既没有 file_path 键、
    # 也不是 shell 写命令，前面的 WRITE_TOOLS 分支和后面的 Bash 分支都漏。
    # 不补这条，Codex 下 apply_patch 改判据 / 改只读配置一路畅通（同 state 校验那个欠拦）。
    for tgt in apply_patch_paths(payload):
        hit = _under(os.path.join(root, tgt), roots)
        if hit:
            return (f"{os.path.basename(hit)} 是只读区，不能改（apply_patch 目标：{tgt}）。\n"
                    f"判据被改动，验证就失去意义。该改的是被测代码，不是尺子。")

    # 二、Bash —— 只看**写入目标**，读和执行一律放行
    cmd = extract_command(payload)
    if not cmd:
        return None

    for tgt in write_targets(cmd):
        hit = _under(os.path.join(root, tgt), roots)
        if hit:
            return (f"这条命令会写入只读区 {os.path.basename(hit)}（目标：{tgt}）。\n"
                    f"判据被改动，验证就失去意义。该改的是被测代码，不是尺子。")

    # 三、git 的写子命令 + 只读区路径（`cd ro && git commit`、`git -C ro reset`）
    if GIT_WRITE.search(cmd):
        for tok in re.split(r"[\s;|&]+", cmd):
            tok = tok.strip("\"'")
            if not tok or tok.startswith("-"):
                continue
            hit = _under(os.path.join(root, tok), roots)
            if hit:
                return (f"这条命令会对只读区 {os.path.basename(hit)} 做 git 写操作。\n"
                        f"判据被改动，验证就失去意义。")

    return None


def record_hit(root: str, rule_id: str, decision: str) -> None:
    """记一笔命中。这是棘爪释放的数据基础 —— 没有命中统计，减法就只能靠拍脑袋。

    失败绝不能影响拦截本身：审计是次要的，门禁是主要的。
    """
    try:
        rd = os.path.join(root, ".ratchet")
        if not os.path.isdir(rd):
            return
        line = json.dumps(
            {"rule": rule_id, "decision": decision,
             "at": datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")},
            ensure_ascii=False,
        )
        with open(os.path.join(rd, "hits.jsonl"), "a", encoding="utf-8") as fh:
            fh.write(line + "\n")
    except Exception:
        pass


def emit(decision: str | None, reason: str = "", rule_id: str = "", root: str = "") -> int:
    if decision is None:
        print("{}")
        return 0
    if rule_id and root:
        record_hit(root, rule_id, decision)
    json.dump(
        {"hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": decision,
            "permissionDecisionReason": f"[ratchet-guard] {reason}",
        }},
        sys.stdout, ensure_ascii=False,
    )
    print()
    return 0  # 决策走 JSON body，退出码恒 0（非 0 会被当成 hook 故障）


def main() -> int:
    if "--list-rules" in sys.argv:
        json.dump(
            {"deny": [r[0] for r in DENY], "ask": [r[0] for r in ASK] + ["slopsquatting"]},
            sys.stdout, ensure_ascii=False,
        )
        print()
        return 0

    try:
        payload = json.load(sys.stdin)
    except Exception:
        return emit(None)  # 读不懂就放行，guard 不该把会话卡死

    root = payload.get("cwd") or os.environ.get("CLAUDE_PROJECT_DIR") or os.getcwd()

    # 只读区先判 —— 它要拦 Edit/Write，而那些工具压根没有 command 字段，
    # 放到 extract_command 之后就永远轮不到它。
    ro = check_readonly(payload, root)
    if ro:
        return emit("deny", ro, "readonly", root)

    cmd = extract_command(payload)
    if not cmd:
        return emit(None)

    scan, fallback = scan_text(cmd)
    note = FALLBACK_NOTE.get(fallback or "", "")

    for rid, pat, why in DENY:
        if pat.search(scan):
            return emit("deny", why + note, rid, root)

    slop = check_install(scan, root)
    if slop:
        return emit("ask", slop, "slopsquatting", root)

    for rid, pat, why in ASK:
        if pat.search(scan):
            return emit("ask", why + note, rid, root)

    return emit(None)


if __name__ == "__main__":
    sys.exit(main())
