#!/usr/bin/env python3
"""
ratchet-brief — 把 state.json 渲染成会话起手简报。

这是「状态与叙述分离」的渲染端：state.json 是唯一真源，简报由它生成。
简报不落盘、不可手工编辑，因此永不过期 —— 原工程 164 KB 的 current.md
和 31 KB 的正则校验脚本，大半检查项在这个设计下不是被修好，而是不再需要存在。

输出硬上限 2 KB（K1）。schema 的 maxItems/maxLength 已在结构上保证不会超，
本脚本再做一次运行时断言：超了就是 schema 被绕过了，必须暴露而不是静默截断。

用法:
  ratchet-brief [--state PATH] [--budget BYTES]
  ratchet-brief --check          # 只校验预算，不输出简报（CI/单测用）
退出码:
  0 正常
  1 state.json 不存在或非法
  2 超出字节预算（K1 被破坏）
"""
import argparse
import json
import os
import sys

BUDGET = 2048  # K1: 起手注入 ≤ 2 KB


HITS_LINE_MAX = 150  # 这一行的字节硬上限。挤爆 2 KB 预算的提示不如不提示。


def find_state(explicit=None):
    if explicit:
        return explicit
    d = os.environ.get("CLAUDE_PROJECT_DIR") or os.getcwd()
    return os.path.join(d, ".ratchet", "state.json")


def pending_hits(state_path):
    """未棘轮化的 guard 命中：规则名 → 次数。

    棘轮零转化的根因是它缺一个触发器：留痕、门禁、状态校验全是 hook 自动跑的，
    唯独「失败 → 永久约束」这一步指望人想起来 —— 而失败随着会话上下文一起蒸发。
    guard 每次命中都写了 hits.jsonl，机器写的、零歧义，只是从来没人消费。
    这里就是那个消费端：起手时把它顶到眼前。

    `ratcheted` 缺失即视为「未处理」—— 老的 hits.jsonl 没这个字段，必须向后兼容。
    """
    p = os.path.join(os.path.dirname(state_path), "hits.jsonl")
    cnt = {}
    try:
        with open(p, encoding="utf-8") as fh:
            for line in fh:
                try:
                    h = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if h.get("ratcheted") is True:
                    continue
                r = h.get("rule") or "?"
                cnt[r] = cnt.get(r, 0) + 1
    except OSError:
        pass
    return cnt


def hits_line(cnt):
    """渲染那一行提示。放不下就退化成只报数量 —— 但绝不放弃提示。"""
    if not cnt:
        return None
    total = sum(cnt.values())
    names = "·".join(r for r, _ in sorted(cnt.items(), key=lambda kv: -kv[1]))
    line = f"⚙️ {total} 条 guard 命中未棘轮化（{names}）→ /ratchet:ratchet 转化，或驳回"
    if len(line.encode("utf-8")) > HITS_LINE_MAX:
        line = f"⚙️ {total} 条 guard 命中未棘轮化 → /ratchet:ratchet 转化，或驳回"
    return line


def render(st, state_path=None):
    L = []
    cur = st.get("current", {})
    it, stage = cur.get("iteration"), cur.get("stage")

    head = "# 当前状态"
    if it or stage:
        head += f"  ·  {it or ''}{' / ' if it and stage else ''}{stage or ''}"
    L.append(head)
    L.append("")
    L.append(f"**在做**：{cur.get('task', '(未设置)')}")
    L.append(f"**下一步**：{cur.get('next', '(未设置)')}")

    blocked = st.get("blocked") or []
    if blocked:
        L.append("")
        L.append("## 🚫 阻塞")
        for b in blocked:
            since = f"（{b['since']} 起）" if b.get("since") else ""
            L.append(f"- {b['what']}{since} → 解除条件：{b['unblock']}")

    pend = st.get("pending_user") or []
    if pend:
        L.append("")
        L.append("## ❓ 等你拍板")
        for p in pend:
            L.append(f"- {p['question']}")

    dec = st.get("recent_decisions") or []
    if dec:
        L.append("")
        L.append("## 🗳️ 最近决策")
        for d in dec:
            L.append(f"- {d['decision']} —— {d['why']}")

    sess = st.get("session") or {}
    tail = []
    if sess.get("log_written") is False:
        tail.append(f"⚠️ 上次会话（s-{sess.get('last', '?')}）的日志未写，先补写再开新工作。")
    if state_path:
        hl = hits_line(pending_hits(state_path))
        if hl:
            tail.append(hl)
    if tail:
        L.append("")
        L.extend(tail)

    return "\n".join(L) + "\n"


def emit_hook(text: str) -> int:
    """SessionStart hook：把简报注入上下文。

    未 init 的项目一律输出 {} 静默退出 —— plugin 装在全局，会在每个项目启动。
    一个到处刷存在感的 hook 会被用户直接卸载，那时保护等于零。
    """
    if text:
        json.dump(
            {"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": text}},
            sys.stdout, ensure_ascii=False,
        )
        print()
    else:
        print("{}")
    return 0


def main():
    ap = argparse.ArgumentParser(add_help=False)
    ap.add_argument("--state")
    ap.add_argument("--budget", type=int, default=BUDGET)
    ap.add_argument("--check", action="store_true")
    ap.add_argument("--hook", action="store_true")
    ap.add_argument("-h", "--help", action="store_true")
    a = ap.parse_args()
    if a.help:
        print(__doc__)
        return 0

    path = find_state(a.state)
    if not os.path.isfile(path):
        if a.hook:
            return emit_hook("")  # 非 ratchet 项目：闭嘴
        print(f"ratchet: 未找到 {path}（先跑 /ratchet:init）", file=sys.stderr)
        return 1
    try:
        st = json.load(open(path, encoding="utf-8"))
    except json.JSONDecodeError as e:
        if a.hook:
            return emit_hook(f"⚠️ .ratchet/state.json 不是合法 JSON（{e}）—— 先修好它。")
        print(f"ratchet: state.json 非法 JSON — {e}", file=sys.stderr)
        return 1

    out = render(st, path)
    n = len(out.encode("utf-8"))

    if n > a.budget:
        msg = (
            f"简报 {n} B 超出预算 {a.budget} B（K1 被破坏）。"
            f"schema 的 maxItems/maxLength 应已阻止这种情况 —— 检查 state.json 是否绕过了 schema 校验。"
        )
        if a.hook:
            # 超预算时宁可截断也要注入 —— 但必须把「机制坏了」这件事明说出来
            return emit_hook(out[: a.budget] + f"\n\n⚠️ {msg}")
        print(f"ratchet: {msg}", file=sys.stderr)
        return 2

    if a.hook:
        return emit_hook(out)

    if a.check:
        print(f"ok: {n}/{a.budget} B ({n * 100 // a.budget}% of K1 budget)")
        return 0

    sys.stdout.write(out)
    return 0


if __name__ == "__main__":
    sys.exit(main())
